// Command test_llms is a standalone scoring harness for the LLM vendor/product
// extraction. It loads testset.json (real NVD CVEs with CPE-derived ground
// truth) and, for each configured provider, runs llm.ExtractVendorProduct and
// scores the predictions against the truth using fuzzy product-name matching.
//
// It is intentionally decoupled from the running app: run this to measure and
// improve extraction quality, then start the app to validate end-to-end.
//
// Env:
//
//	TEST_PROVIDER=gemini|mistral|ollama   limit to one provider (default: all three)
//	TEST_LIMIT=N                          only score the first N CVEs
//	TEST_CVE=CVE-2023-1234                only score this CVE id
//	VERBOSE=true                          print predictions for every CVE
package main

import (
	"context"
	"cve-tracker/internal/config"
	"cve-tracker/internal/llm"
	"encoding/json"
	"fmt"
	"log/slog"
	"os"
	"regexp"
	"sort"
	"strings"
)

type truthProduct struct {
	Vendor  string `json:"vendor"`
	Product string `json:"product"`
}

type testCVE struct {
	ID    string         `json:"id"`
	Year  int            `json:"year"`
	Desc  string         `json:"desc"`
	Refs  []string       `json:"refs"`
	Truth []truthProduct `json:"truth"`
}

type score struct {
	tested      int
	fullPass    int // every truth product matched
	partial     int // some but not all matched
	miss        int // nothing matched
	errored     int
	recallSum   float64
	precisonSum float64
}

func main() {
	if err := run(); err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}
}

func run() error {
	slog.SetDefault(slog.New(slog.NewTextHandler(os.Stderr, &slog.HandlerOptions{Level: slog.LevelWarn})))

	config.AppConfig = config.Config{
		LLMEndpoint:      envOr("LLM_ENDPOINT", "http://ollama:11434"),
		LLMModel:         envOr("LLM_MODEL", "phi3-vulfixx"),
		GeminiAPIKey:     os.Getenv("GEMINI_API_KEY"),
		GeminiModel:      envOr("GEMINI_MODEL", "gemini-3.1-flash-lite"),
		GeminiAPIVersion: envOr("GEMINI_API_VERSION", "v1beta"),
		MistralAPIKey:    os.Getenv("MISTRAL_API_KEY"),
		MistralModel:     envOr("MISTRAL_MODEL", "mistral-small-latest"),
		MistralEndpoint:  envOr("MISTRAL_ENDPOINT", "https://api.mistral.ai/v1"),
		LLMTimeout:       envIntOr("LLM_TIMEOUT", 1800),
	}

	data, err := os.ReadFile("testset.json")
	if err != nil {
		return fmt.Errorf("cannot read testset.json: %w\n(run: go run ./cmd/fetch_cves to build it)", err)
	}
	var cves []testCVE
	if err := json.Unmarshal(data, &cves); err != nil {
		return fmt.Errorf("error parsing testset.json: %w", err)
	}
	for i := range cves {
		cves[i].Truth = filterTruth(cves[i].Truth, cves[i].Desc)
	}

	providers := []string{"gemini", "mistral", "ollama"}
	if tp := os.Getenv("TEST_PROVIDER"); tp != "" {
		providers = strings.Split(tp, ",")
	}
	limit := envIntOr("TEST_LIMIT", -1)
	onlyCVE := os.Getenv("TEST_CVE")
	verbose := os.Getenv("VERBOSE") == "true"

	fmt.Printf("Loaded %d CVEs from testset.json (years %s)\n", len(cves), yearSpread(cves))

	for _, p := range providers {
		p = strings.TrimSpace(p)
		config.AppConfig.LLMProvider = p
		fmt.Printf("\n========================================================\n")
		fmt.Printf("Provider: %s\n", p)
		fmt.Printf("========================================================\n")

		var sc score
		for i, c := range cves {
			if onlyCVE != "" && c.ID != onlyCVE {
				continue
			}
			if limit >= 0 && sc.tested >= limit {
				break
			}
			sc.tested++

			ctx := context.Background()
			results, err := llm.ExtractVendorProduct(ctx, c.Desc, c.Refs)
			if err != nil {
				sc.errored++
				fmt.Printf("[%d %s] ERROR: %v\n", i, c.ID, err)
				continue
			}

			recall, precision, matched := scoreOne(c.Truth, results)
			sc.recallSum += recall
			sc.precisonSum += precision
			status := "MISS "
			switch {
			case recall >= 0.999:
				sc.fullPass++
				status = "PASS "
			case recall > 0:
				sc.partial++
				status = "PART "
			default:
				sc.miss++
			}

			if verbose || recall < 0.999 {
				fmt.Printf("[%s] %s (r=%.2f p=%.2f)\n", status, c.ID, recall, precision)
				fmt.Printf("    truth: %s\n", fmtTruth(c.Truth))
				fmt.Printf("    pred : %s\n", fmtPred(results, matched))
			} else {
				fmt.Printf("[%s] %s\n", status, c.ID)
			}
		}

		n := float64(sc.tested)
		if n == 0 {
			n = 1
		}
		fmt.Printf("\n-- %s summary --\n", p)
		fmt.Printf("  tested=%d  PASS=%d  PARTIAL=%d  MISS=%d  ERROR=%d\n",
			sc.tested, sc.fullPass, sc.partial, sc.miss, sc.errored)
		fmt.Printf("  avg recall=%.3f  avg precision=%.3f  full-pass rate=%.1f%%\n",
			sc.recallSum/n, sc.precisonSum/n, 100*float64(sc.fullPass)/n)
	}
	return nil
}

// distroVendors are Linux distributions / OS packagers that appear in CPE
// configurations because they shipped a vulnerable package, NOT because they
// are the software named in the CVE description. They are noise for an
// extraction-from-description task, so we drop them from the ground truth.
var distroVendors = map[string]bool{
	"fedoraproject": true, "fedora": true, "debian": true, "canonical": true,
	"ubuntu": true, "opensuse": true, "suse": true, "redhat": true, "red hat": true,
	"novell": true, "mandriva": true, "mandrakesoft": true, "gentoo": true,
	"slackware": true, "trustix": true, "conectiva": true, "turbolinux": true,
}

// filterTruth keeps only the ground-truth products that an extractor could
// plausibly recover from the CVE text. CPE configurations list every distro
// that repackaged a library (Fedora, Ubuntu, RHEL, ...) and, for hardware bugs,
// dozens of chipset model numbers — none of which appear in the prose. We keep
// a truth product only if it is a distro-free entry whose most distinctive name
// token actually occurs in the description. If filtering would empty the list,
// the original is kept so the CVE remains scoreable.
func filterTruth(t []truthProduct, desc string) []truthProduct {
	dtoks := descTokenSet(desc)
	var out []truthProduct
	for _, p := range t {
		if distroVendors[strings.ToLower(strings.TrimSpace(p.Vendor))] {
			continue
		}
		if mentioned(p.Product, dtoks) || mentioned(p.Vendor, dtoks) {
			out = append(out, p)
		}
	}
	if len(out) == 0 {
		return t
	}
	return out
}

func descTokenSet(desc string) map[string]bool {
	set := map[string]bool{}
	for _, t := range strings.Fields(nonAlnum.ReplaceAllString(strings.ToLower(desc), " ")) {
		set[t] = true
	}
	return set
}

// mentioned reports whether the most distinctive token of name (the longest one
// after dropping generic words) appears in the description token set. Using the
// longest token avoids matching on generic words like "linux" or "server".
func mentioned(name string, dtoks map[string]bool) bool {
	toks := tokens(name)
	if len(toks) == 0 {
		return true // nothing distinctive to check; don't filter it out
	}
	longest := ""
	for _, t := range toks {
		if len(t) > len(longest) {
			longest = t
		}
	}
	return dtoks[longest]
}

// scoreOne returns recall (fraction of truth products matched by some
// prediction), precision (fraction of predictions matching some truth), and the
// set of prediction indices that matched.
func scoreOne(truth []truthProduct, preds []llm.ProductResult) (recall, precision float64, matchedPred map[int]bool) {
	matchedPred = map[int]bool{}
	if len(truth) == 0 {
		return 0, 0, matchedPred
	}
	truthHit := 0
	for _, t := range truth {
		for j, p := range preds {
			if productMatch(t.Product, p.Product) || productMatch(t.Vendor, p.Product) {
				truthHit++
				matchedPred[j] = true
				break
			}
		}
	}
	// A prediction counts toward precision if it matches ANY truth product.
	predHit := 0
	for j, p := range preds {
		for _, t := range truth {
			if productMatch(t.Product, p.Product) || productMatch(t.Vendor, p.Product) {
				matchedPred[j] = true
				predHit++
				break
			}
		}
	}
	recall = float64(truthHit) / float64(len(truth))
	if len(preds) > 0 {
		precision = float64(predHit) / float64(len(preds))
	}
	return recall, precision, matchedPred
}

var nonAlnum = regexp.MustCompile(`[^a-z0-9]+`)

func tokens(s string) []string {
	s = strings.ToLower(s)
	s = nonAlnum.ReplaceAllString(s, " ")
	var out []string
	for _, t := range strings.Fields(s) {
		// Drop ultra-generic words that create false matches.
		switch t {
		case "the", "a", "an", "for", "and", "software", "project", "plugin", "module", "server", "system":
			continue
		}
		out = append(out, t)
	}
	return out
}

// productMatch fuzzily compares a CPE-derived name against an LLM-predicted
// name. CPE names are underscore-joined and lowercase ("popup_builder"); LLM
// output is prose ("Popup Builder"). We treat them as matching when one token
// set is a subset of the other, or there is substantial token overlap.
func productMatch(truth, pred string) bool {
	tt := tokens(truth)
	pt := tokens(pred)
	if len(tt) == 0 || len(pt) == 0 {
		return false
	}
	tset := map[string]bool{}
	for _, t := range tt {
		tset[t] = true
	}
	pset := map[string]bool{}
	for _, t := range pt {
		pset[t] = true
	}
	inter := 0
	for t := range tset {
		if pset[t] {
			inter++
		}
	}
	if inter == 0 {
		return false
	}
	// Subset either direction (handles "windows" vs "windows 10").
	if inter == len(tset) || inter == len(pset) {
		return true
	}
	// Jaccard overlap.
	union := len(tset) + len(pset) - inter
	return float64(inter)/float64(union) >= 0.5
}

func fmtTruth(t []truthProduct) string {
	var parts []string
	for _, p := range t {
		parts = append(parts, p.Vendor+"/"+p.Product)
	}
	return strings.Join(parts, ", ")
}

func fmtPred(p []llm.ProductResult, matched map[int]bool) string {
	if len(p) == 0 {
		return "(none)"
	}
	var parts []string
	for i, r := range p {
		mark := " "
		if matched[i] {
			mark = "✓"
		}
		parts = append(parts, fmt.Sprintf("%s%s/%s [%s]", mark, r.Vendor, r.Product, r.Version))
	}
	return strings.Join(parts, ", ")
}

func yearSpread(cves []testCVE) string {
	counts := map[int]int{}
	for _, c := range cves {
		counts[c.Year]++
	}
	var ys []int
	for y := range counts {
		ys = append(ys, y)
	}
	sort.Ints(ys)
	var parts []string
	for _, y := range ys {
		parts = append(parts, fmt.Sprintf("%d:%d", y, counts[y]))
	}
	return strings.Join(parts, " ")
}

func envOr(k, def string) string {
	if v := os.Getenv(k); v != "" {
		return v
	}
	return def
}

func envIntOr(k string, def int) int {
	if v := os.Getenv(k); v != "" {
		var n int
		if _, err := fmt.Sscanf(v, "%d", &n); err == nil {
			return n
		}
	}
	return def
}
