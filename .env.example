# Database Configuration
DB_HOST=db
DB_PORT=5432
DB_USER=cveuser
DB_PASSWORD=cvepass
DB_NAME=cvetracker
DB_SSLMODE=prefer # options: disable, prefer, require, verify-ca, verify-full

# Redis Configuration
REDIS_URL=redis:6379

# Session and Security
SESSION_KEY=change-me-to-a-long-random-string
CSRF_KEY=MOCK_CSRF_KEY_32_BYTES_FOR_TEST! # Must be 32 bytes
SECURE_COOKIE=false # Set to true in production with HTTPS (affects session store)

# Administrator Account (REQUIRED)
# These values are used to seed the initial admin user.
# TOTP is mandatory for the admin account.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-something-secure
ADMIN_TOTP_SECRET=YOUR_TOTP_SECRET_BASE32 # Generate a secure base32 secret

# SMTP Configuration (Optional but recommended for alerts)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=password
SMTP_MAILFROM=alerts@example.com # Sender address for emails

# Application URL
BASE_URL=http://localhost:8080

# NVD API Configuration
# Get a free API key at https://nvd.nist.gov/developers/request-an-api-key
# Without a key, rate limits are strict (5 requests per 30s).
# With a key, rate limits are 50 requests per 30s.
# NVD_API_KEY=your-api-key-here

# LLM Enrichment Configuration
# Provider options: gemini35flash, gemini3flash, gemini31flashlite, mistral, ollama, openai
# You can use a comma-separated list for priority fallback (e.g. gemini31flashlite,mistral)
LLM_PROVIDER=gemini31flashlite,mistral

# Google Gemini Configuration (Free tier available at https://aistudio.google.com/)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite # Flash Lite is fast, cheap and available on the free tier
GEMINI_API_VERSION=v1beta # Required: stable v1 rejects responseMimeType/responseSchema (structured output)
GEMINI_RPM=15 # Free-tier requests/minute used to pace calls (gemini-3.1-flash-lite = 15 RPM / 500 RPD; raise for paid tiers)
GEMINI_RPD=500 # Free-tier requests/day hard ceiling (tracked in Redis, UTC day; 0 disables; raise for paid tiers)

# Higher-quality, low-quota Gemini failovers. Put them FIRST in LLM_PROVIDER so they
# are used while their small daily quota lasts, then fall through to flash-lite:
#   LLM_PROVIDER=gemini35flash,gemini3flash,gemini31flashlite,mistral,ollama
GEMINI35FLASH_MODEL=gemini-3.5-flash # "Gemini 3.5 Flash"
GEMINI35FLASH_RPM=5
GEMINI35FLASH_RPD=20
GEMINI3FLASH_MODEL=gemini-3-flash-preview # "Gemini 3 Flash"
GEMINI3FLASH_RPM=5
GEMINI3FLASH_RPD=20



# Ollama Configuration (Local)
# LLM_PROVIDER=ollama
# LLM_ENDPOINT=http://ollama:11434
# LLM_MODEL=phi3-vulfixx

# Mistral Configuration
# LLM_PROVIDER=mistral
# MISTRAL_API_KEY=your-mistral-key
# MISTRAL_MODEL=mistral-small-latest

# OpenAI Compatible Configuration (Local/Custom Proxy)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your-openai-key (optional/empty if no key required)
# OPENAI_MODEL=kilo-auto/free
# OPENAI_ENDPOINT=http://100.115.58.99:18080/workspace/sys-kilo/v1

# Global LLM Settings
LLM_TIMEOUT=600
LLM_DEBUG=false

